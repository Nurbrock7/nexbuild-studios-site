# ─────────────────────────────────────────────────────────
# Nexbuild Studios — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ─────────────────────────────────────────────────────────

# Phase 3 — Lead Concierge agent (Claude API, server-side only)
ANTHROPIC_API_KEY=

# Phase 3 — MongoDB Atlas (leads collection)
MONGODB_URI=

# Phase 4 — Resend (transactional email: auto-reply + owner notification)
RESEND_API_KEY=
# Address the auto-reply is sent FROM (must be a verified Resend domain/sender)
LEAD_FROM_EMAIL="Nexbuild Studios <hello@nexbuildstudios.com>"
# Where new-lead notifications are sent (you)
LEAD_NOTIFY_EMAIL=nurbrock7@gmail.com

# Phase 4 — Cal.com booking link included in qualified auto-replies
CAL_BOOKING_URL=https://cal.com/nexbuild/discovery
